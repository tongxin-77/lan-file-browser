# 默认：文本文件统一 LF
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.syso binary
*.jks binary
*.keystore binary
*.exe binary
*.db binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
